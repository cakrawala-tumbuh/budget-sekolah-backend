# Environment — Budget Backend YPII
# Salin file ini menjadi .env dan sesuaikan nilainya.

# Tahun anggaran instance ini (format YYYY-YYYY)
BUDGET_YEAR=2025-2026

# URL database SQLite
DATABASE_URL=sqlite:///./budget_ypii.db

# Nama aplikasi (ditampilkan di docs)
APP_NAME="Budget Simulator YPII"

# Aktifkan reload otomatis saat development (true/false)
DEBUG=false

# ── Autentikasi ────────────────────────────────────────────────────────────────

# Password untuk akun admin (WAJIB diganti di production)
ADMIN_PASSWORD=admin123

# Secret key untuk signing JWT token (WAJIB diganti di production, gunakan string acak panjang)
JWT_SECRET_KEY=changeme-set-this-in-env

# Masa berlaku JWT token dalam menit (default 480 = 8 jam)
JWT_EXPIRE_MINUTES=480
